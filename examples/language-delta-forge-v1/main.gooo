package language_delta_forge
namespace language_delta_forge

entity ImmutableGoooRelease id "gooo://language-delta-forge/entity/immutable-release"
entity FailureReceipt id "gooo://language-delta-forge/entity/failure-receipt"
entity UnknownReceipt id "gooo://language-delta-forge/entity/unknown-receipt"
entity RefutedReceipt id "gooo://language-delta-forge/entity/refuted-receipt"
entity ExactTarget id "gooo://language-delta-forge/entity/exact-target"
