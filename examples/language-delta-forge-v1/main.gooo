entity IndependentConsumerReceipt id "gooo://language-delta-forge/entity/independent-consumer-receipt"
entity CandidateBundle id "gooo://language-delta-forge/entity/candidate-bundle"

activity ObserveImmutableRelease(ImmutableGoooRelease) -> CandidateBundle
activity ConsumeFailureReceipt(FailureReceipt) -> CandidateBundle
activity PreserveUnknownReceipt(UnknownReceipt) -> CandidateBundle
activity PrioritizeRefutedReceipt(RefutedReceipt) -> CandidateBundle
activity BindExactTarget(ExactTarget) -> CandidateBundle
activity BindCausalFrontier(CausalFrontier) -> CandidateBundle
activity BindSemanticGraphDelta(SemanticGraphDelta) -> CandidateBundle
activity BindRollbackDelta(RollbackDelta) -> CandidateBundle
activity BindConformanceManifest(ConformanceManifest) -> CandidateBundle
activity BindIndependentConsumerReceipt(IndependentConsumerReceipt) -> CandidateBundle
activity EmitReadOnlyCandidate(CandidateBundle) -> CandidateBundle

gooo language_delta_forge v1
denominator id=language-delta-forge-v1 cell_count=18
authority repository_writes=0 local_test_executions=0 protected_core_adoption=0 merge_authority=0
precedence REFUTED>UNKNOWN>CLOSED
